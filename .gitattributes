# 统一换行符，避免 Windows/Linux 协作时产生整文件 diff
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf

# CSV 保留 CRLF，便于 Excel 直接打开
*.csv     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.zip     binary

# 审计归档含逐文件 SHA256，保留实验产物与执行源码快照的原始字节。
# SVG/补丁由工具生成，行尾空格不属于源代码风格检查范围。
results/member_A_audit_20261105/** -text whitespace=-blank-at-eol
