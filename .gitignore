# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/

# ---------------------------------------------------------------- 运行产物（体积大 / 可重新生成）
# 断点续采缓存：669 个逐日切片 + checkpoint，约 150MB
state/
# 运行日志
logs/

# ---------------------------------------------------------------- 建模产物
# 二进制产物不入库：
#   model.pt            单个最大 11MB，23 个运行合计约 250MB
#   feature_builder.pkl 含 SVD 分量矩阵（300×10864 float64），单个最大 25MB
# 训练是确定性的，可用 train_bp.py 以相同种子完整重建（见 README 11.5）；
# 报告中引用的指标保存在已提交的 metrics.json / experiment_summary.csv 中。
/results/**/model.pt
/results/**/feature_builder.pkl
# 分词缓存：可由语料重新生成
results/cache/

# ---------------------------------------------------------------- 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 工具目录
.workbuddy/

# 自建数据集及其所有子目录均为研究资产，覆盖上方通用忽略规则。
!/dataset/**/*
